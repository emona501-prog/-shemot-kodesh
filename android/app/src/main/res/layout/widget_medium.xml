<?xml version="1.0" encoding="utf-8"?>
<!-- וידג'ט רחב: גלגל בצד, טקסט לידו, כפתורים למטה -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_wheel" android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="גלגל השמות - לחיצה מגרילה שם" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFDAA520" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textDirection="rtl" />
            <TextView android:id="@+id/w_segula" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFF3D78E" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textDirection="rtl" />
            <TextView android:id="@+id/w_pasuk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFE4DAC2" android:textSize="12sp" android:lineSpacingExtra="2dp" android:maxLines="3" android:ellipsize="end" android:textDirection="rtl" />
            <TextView android:id="@+id/w_src" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FF8A7A5A" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textDirection="rtl" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/b_prev" android:layout_width="0dp" android:layout_height="34dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:textSize="12sp" android:layout_weight="1" android:background="@drawable/widget_btn" android:textColor="#FFF6EFDC" android:text="› הקודם" />
        <TextView android:id="@+id/b_spin" android:layout_width="0dp" android:layout_height="34dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:textSize="12sp" android:layout_weight="1.3" android:background="@drawable/widget_btn_gold" android:textColor="#FF1A1206" android:textStyle="bold" android:text="🎲 גורל" />
        <TextView android:id="@+id/b_next" android:layout_width="0dp" android:layout_height="34dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:textSize="12sp" android:layout_weight="1" android:background="@drawable/widget_btn" android:textColor="#FFF6EFDC" android:text="הבא ‹" />
        <TextView android:id="@+id/b_auto" android:layout_width="0dp" android:layout_height="34dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:textSize="12sp" android:layout_weight="1" android:background="@drawable/widget_btn" android:textColor="#FFF6EFDC" android:text="⏸ עצור" />
        <TextView android:id="@+id/b_open" android:layout_width="0dp" android:layout_height="34dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:textSize="12sp" android:layout_weight="0.9" android:background="@drawable/widget_btn" android:textColor="#FFF3D78E" android:text="פתח ↗" />
    </LinearLayout>
</LinearLayout>
