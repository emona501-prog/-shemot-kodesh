<?xml version="1.0" encoding="utf-8"?>
<!-- וידג'ט נמוך (שורה אחת): השם באמצע, חצים בצדדים; לחיצה על השם מגרילה -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl" android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:padding="6dp">
    <TextView android:id="@+id/b_prev" android:layout_width="38dp" android:layout_height="match_parent" android:gravity="center" android:maxLines="1" android:background="@drawable/widget_btn" android:textColor="#FFF6EFDC" android:textSize="20sp" android:text="›" />
    <LinearLayout android:id="@+id/w_tap" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_marginStart="6dp" android:layout_marginEnd="6dp">
        <TextView android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF3D78E" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_segula" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFE4DAC2" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textDirection="rtl" />
    </LinearLayout>
    <TextView android:id="@+id/b_open" android:layout_width="38dp" android:layout_height="match_parent" android:gravity="center" android:maxLines="1" android:background="@drawable/widget_btn" android:layout_marginEnd="4dp" android:textColor="#FFF3D78E" android:textSize="15sp" android:text="↗" />
    <TextView android:id="@+id/b_next" android:layout_width="38dp" android:layout_height="match_parent" android:gravity="center" android:maxLines="1" android:background="@drawable/widget_btn" android:textColor="#FFF6EFDC" android:textSize="20sp" android:text="‹" />
</LinearLayout>
